{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/game.ts": {
      "maxDuration": 300,
      "includeFiles": "public/wasm/outnumbered.wasm"
    }
  },
  "rewrites": [
    { "source": "/ws", "destination": "/api/game" },
    { "source": "/api/health", "destination": "/api/game" },
    { "source": "/api/rooms", "destination": "/api/game" }
  ]
}
